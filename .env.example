# Port the HTTP server listens on. Defaults to 8080 if unset.
PORT=8080

# Secret used to sign and verify JWTs. REQUIRED in any real deployment
# (a random one is generated per-process if unset, which means issued
# tokens stop working after every restart).
JWT_SECRET=change-me-to-a-long-random-string

# How long an issued JWT stays valid, in minutes. Defaults to 60.
TOKEN_TTL_MINUTES=60
